generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(cuid())
  name              String
  firstName         String?
  secondName        String?
  firstSurname      String?
  secondSurname     String?
  dateOfBirth       DateTime?     @db.Date
  countryOfResidence String?
  age               Int?
  currency          String        @default("GTQ")
  expenseCategories String[]      @default([])
  email             String        @unique
  passwordHash      String
  createdAt         DateTime      @default(now())
  transactions Transaction[]
  goals        Goal[]
  contributions GoalContribution[]
  budgets      Budget[]
}

model Transaction {
  id            String   @id @default(cuid())
  title         String
  category      String
  type          TxType
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime
  paymentMethod String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  @@index([userId, date])
}

model Goal {
  id       String   @id @default(cuid())
  name     String
  target   Decimal  @db.Decimal(12, 2)
  saved    Decimal  @default(0) @db.Decimal(12, 2)
  deadline DateTime
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model GoalContribution {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  date      DateTime @default(now())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([goalId, date])
  @@index([userId, date])
}

model Budget {
  id           String   @id @default(cuid())
  category     String
  monthlyLimit Decimal  @db.Decimal(12, 2)
  month        DateTime @db.Date
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, category, month])
  @@index([userId, month])
}

enum TxType {
  INCOME
  EXPENSE
}
